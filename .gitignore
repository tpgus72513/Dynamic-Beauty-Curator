# ============================================================
# .gitignore — 깃(GitHub)에 올리지 않을 파일 목록
# ============================================================

# API 키가 든 파일 — 절대 올리면 안 됨!
.env
backend/.env

# 파이썬 캐시
__pycache__/
*.py[cod]
*.pyc

# 가상환경
venv/
env/
.venv/

# 프론트엔드 의존성/빌드 산출물
frontend/node_modules/
frontend/dist/
frontend/dist-*/

# 로컬 피부 분석 모델과 얼굴 검증 이미지
backend/model/skin_multitask/final_model.keras
backend/model/skin_multitask/test_images/

# 크롤링 결과 (용량이 크고, 각자 수집하므로)
crawler/reviews_*.csv
analysis/reviews_*.csv
analysis/keyword_analysis.json

# OS / 에디터 파일
.DS_Store
Thumbs.db
.vscode/
.idea/

# 크롬 드라이버 (webdriver-manager가 자동 관리)
*.exe
chromedriver*
