# ============================================================
# API 키 설정 양식
# ============================================================
# 사용법:
#   1. 이 파일을 복사해서 같은 폴더에 ".env" 라는 이름으로 저장
#   2. 아래 빈칸에 발급받은 키를 붙여넣기
#   3. .env 파일은 절대 깃(GitHub)에 올리지 말 것!
#
# 키 발급 방법은 docs/API_SETUP.md 참고
# ============================================================

# 기상청 자외선 관측 API 인증키
KMA_UV_API_KEY=여기에_기상청_키_붙여넣기

# 에어코리아 인증키 (대기오염정보 + 측정소정보 공용)
AIRKOREA_API_KEY=여기에_에어코리아_키_붙여넣기

# 카카오 좌표→행정동 변환 REST API 키 (선택)
KAKAO_API_KEY=여기에_카카오_키_붙여넣기

# 외부 API 호출 실패 시 fallback 사용 여부 (True 권장)
USE_FALLBACK=True

# 브라우저 접근을 허용할 프론트 주소(쉼표 구분, * 사용 금지)
# 비워 두면 localhost:5173/4173만 허용됩니다.
CORS_ORIGINS=
